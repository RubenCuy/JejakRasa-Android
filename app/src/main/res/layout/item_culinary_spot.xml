<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    app:cardBackgroundColor="@color/surface_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="3dp"
    app:strokeColor="@color/divider_warm"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- SPACE GAMBAR KULINER (180dp) -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="180dp">

            <ImageView
                android:id="@+id/ivSpotImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Foto Tempat Kuliner"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_placeholder_food" />

            <!-- Badge Tahun Legendaris -->
            <TextView
                android:id="@+id/tvBadgeLegendaris"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@color/primary_terracotta"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Sejak 1978"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Badge Rating Bintang 5 -->
            <TextView
                android:id="@+id/tvBadgeRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignParentTop="true"
                android:layout_margin="12dp"
                android:background="@color/badge_green_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="★ 4.9"
                android:textColor="@color/badge_green_text"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- INFORMASI SINGKAT TEMPAT KULINER -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvKategoriSpot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Makanan Berat"
                android:textColor="@color/accent_amber"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNamaSpot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="serif"
                android:text="Nama Spot Kuliner"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAlamatSpot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Jl. Contoh Alamat No. 12 • Rp 25.000 - Rp 45.000"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>