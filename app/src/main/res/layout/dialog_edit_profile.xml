<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="22dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:text="Edit Profil &amp; Foto"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"
        android:text="Perubahan akan tersimpan langsung ke akun Firebase"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnPickGalleryProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="Pilih dari Galeri"
            android:textColor="@color/primary_terracotta"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnTakeCameraProfile"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Ambil Foto"
            android:textColor="@color/primary_terracotta"
            android:textSize="12sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/etEditFirstName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Nama Depan"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etEditLastName"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/bg_search_bar"
        android:hint="Nama Belakang"
        android:inputType="textPersonName"
        android:paddingHorizontal="14dp"
        android:textSize="14sp" />

</LinearLayout>