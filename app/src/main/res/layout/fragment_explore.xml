<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_cream">

    <!-- HEADER LOGO, SAPAAN, LOKASI & PENCARIAN -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="@color/primary_terracotta"
        android:orientation="vertical"
        android:paddingHorizontal="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivHeaderLogo"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="12dp"
                android:contentDescription="Logo JejakRasa"
                android:src="@drawable/ic_logo_jejakrasa" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="serif"
                    android:text="JejakRasa"
                    android:textColor="@color/white"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvWelcomeSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="Kurator Kuliner Legendaris &amp; Bintang 5 Lokal"
                    android:textColor="#FED7AA"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- BAR LOKASI SEKARANG / PILIH KOTA (TANPA EMOJI) -->
        <LinearLayout
            android:id="@+id/layoutLocationBar"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_back_pill"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:contentDescription="Ikon Lokasi"
                android:src="@drawable/ic_location_pin" />

            <TextView
                android:id="@+id/tvCurrentLocation"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Lokasi: Semua Kota (Ketuk untuk atur)"
                android:textColor="@color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Ubah"
                android:textColor="#FED7AA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_bar"
            android:hint="Cari soto, gudeg, bakmi, atau kota..."
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="14dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- FILTER KATEGORI HORIZONTAL -->
    <HorizontalScrollView
        android:id="@+id/scrollCategories"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutHeader"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleLine="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Semua" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipHeavyMeal"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Makanan Berat" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipSnack"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Jajanan Legendaris" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDrink"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Minuman &amp; Kopi" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- DAFTAR KATALOG KULINER -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCulinarySpots"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/scrollCategories"
        android:clipToPadding="false"
        android:paddingBottom="96dp" />

    <!-- TOMBOL MELAYANG TANYA AI -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAskAi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="92dp"
        android:text="Tanya AI"
        android:textColor="@color/white"
        android:textStyle="bold"
        app:backgroundTint="@color/primary_terracotta"
        app:icon="@android:drawable/ic_dialog_info"
        app:iconTint="@color/white" />

</RelativeLayout>